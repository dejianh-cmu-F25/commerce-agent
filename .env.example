# Copy to .env and fill in. Never commit .env.
#
# These are exactly the variables the app reads (see _ENV_OVERRIDES in
# app/core/settings.py). A unit test enforces the parity, so add new overrides
# here when you add them to the settings loader.

# --- Model (provider-neutral; default DeepSeek) ---
LLM_PROVIDER=deepseek          # deepseek | openai | anthropic | mock
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=                   # set your key (leave empty to run in mock mode)
# Fallback provider (empty disables): serves a turn when the primary fails first.
LLM_FALLBACK_PROVIDER=         # "" (off) | deepseek | openai | anthropic | mock
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=

# --- Embeddings / vector store (for knowledge.provider=dense) ---
EMBEDDING_PROVIDER=hash        # hash (keyless) | openai | ollama | mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
VECTOR_STORE_PROVIDER=chroma   # chroma (persistent) | memory (keyless/test)

# --- Storefront (system of record for products and orders) ---
STOREFRONT_PROVIDER=sqlite     # memory | sqlite
CATALOG_PROVIDER=hybrid        # hybrid (local index + real embedding) | tfidf (keyless)
CATALOG_INDEX_PATH=./data/discovery/products.json
STOREFRONT_SQLITE_PATH=./data/db/storefront.sqlite
STOREFRONT_SEED_ORDERS=true    # seed demo orders per customer (keyless demo)

# --- Boundary data quality (validate/normalize or fail loud) ---
DATA_QUALITY=repair            # repair (normalize/skip) | strict (fail loud)

# --- Shopify (real post-purchase system of record; empty = keyless fixture) ---
SHOPIFY_SHOP=                 # e.g. my-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=         # Admin API access token (read_orders first)
SHOPIFY_API_VERSION=2025-07

# --- Input guard (hostile/OOD input; refuse before the model) ---
SAFETY_INPUT_GUARD=true        # on by default
SAFETY_MAX_INPUT_CHARS=4000    # refuse longer messages (too_long)

# --- Graceful fallback (dense -> keyless lexical on dependency failure) ---
RESILIENCE_FALLBACK_ENABLED=true

# --- Session log persistence ---
SESSION_STORE=sqlite           # memory | sqlite
SESSION_SQLITE_PATH=./data/db/sessions.sqlite

# --- Customer memory (cross-session) ---
MEMORY_PROVIDER=sqlite         # memory | sqlite
MEMORY_SQLITE_PATH=./data/db/memory.sqlite

# --- Knowledge retrieval ---
KNOWLEDGE_PROVIDER=dense       # dense (embeddings + Chroma) | memory (keyless TF-IDF)
KNOWLEDGE_PATH=./config/knowledge
REVIEWS_PATH=./data/reviews/reviews.sqlite

# --- Returns (machine-readable policy; keep in sync with config/knowledge) ---
RETURNS_WINDOW_DAYS=30

# --- Skills (long-tail procedures in skills/<name>/SKILL.md) ---
SKILLS_ENABLED=true
SKILLS_PATH=./skills

# --- Evaluation (opt-in real runs; see evals/agent_eval.py) ---
EVAL_SEEDS=3
EVAL_PASS_K=3
EVAL_JUDGE=true
EVAL_JUDGE_MODEL=deepseek-chat
EVAL_MAX_COST_CNY=1.0

# --- Observability ---
LOG_LEVEL=INFO
TRACE_FILE=./logs/traces.jsonl

# --- Web ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
